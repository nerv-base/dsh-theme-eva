{
  "name": "dsh-theme-eva",
  "version": "0.3.0",
  "description": "EVA Unit-01 / Unit-02 themes for DeepSeek Harness, switchable live: entry-plug boot cinematic, LCL, sync-rate meter and a restrained everyday skin.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerv-base/dsh-theme-eva.git"
  },
  "homepage": "https://github.com/nerv-base/dsh-theme-eva#readme",
  "bugs": {
    "url": "https://github.com/nerv-base/dsh-theme-eva/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "evangelion",
    "skin"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.cinema.js",
    "assets/icon.svg",
    "assets/fonts/*.woff2",
    "assets/fonts/*.txt",
    "lib/client.voice.js",
    "assets/voice/VOICE-NOTES.json",
    "locale/*.json",
    "cordis.patch.yml",
    "LICENSE",
    "LICENSE-three.txt",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "fonts": "python3 scripts/subset-fonts.py",
    "voice": "node scripts/gen-voice.mjs",
    "preversion": "npm test",
    "version": "npm run build && git add lib"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  }
}
